rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == "PUT_ADMIN_EMAIL_HERE";
    }

    // Site content: public read, admin write
    match /site/content {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Contact-form messages: anyone can create (validated), only admin can read/update/delete
    match /inquiries/{id} {
      allow create: if request.resource.data.keys().hasOnly(
                         ['name','email','phone','date','venue','pkg','social','msg','read','createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 200
                    && request.resource.data.msg.size() <= 3000;
      allow read, update, delete: if isAdmin();
    }
  }
}
